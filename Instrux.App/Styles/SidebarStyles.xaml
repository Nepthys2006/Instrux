<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sidebar Navigation Item with left accent bar -->
    <Style x:Key="SidebarNavItemStyle" TargetType="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="OuterBorder" Padding="0" CornerRadius="0"
                            Background="Transparent">
                        <Grid>
                            <!-- Left accent bar (visible when active) -->
                            <Border x:Name="AccentBar" Width="3" 
                                    Background="{StaticResource PrimaryBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Opacity="0" CornerRadius="0,2,2,0" />
                            <!-- Content -->
                            <Border x:Name="Border" Padding="12,10" CornerRadius="0"
                                    Background="Transparent" Cursor="Hand" Margin="3,0,0,0">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  TextElement.FontSize="14" TextElement.FontWeight="Medium"
                                                  TextElement.Foreground="{StaticResource SidebarTextBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            <Setter TargetName="Border" Property="TextElement.Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Quick Access Item -->
    <Style x:Key="SidebarQuickItemStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Padding="12,8" CornerRadius="6"
                            Background="Transparent" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4"
                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0"
                                    VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.FontSize="13"
                                              TextElement.Foreground="{StaticResource SidebarTextBrush}"
                                              TextElement.FontWeight="Normal" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1E293B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Sidebar Settings Button -->
    <Style x:Key="SidebarSettingStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Padding="12,10" CornerRadius="0"
                            Background="Transparent" Cursor="Hand"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.FontSize="14" TextElement.FontWeight="Medium"
                                          TextElement.Foreground="{StaticResource SidebarTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
