<Application x:Class="Instrux.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Instrux.App.ViewModels"
             xmlns:vmTabs="clr-namespace:Instrux.App.ViewModels.Tabs"
             xmlns:tabs="clr-namespace:Instrux.App.Views.Tabs"
             xmlns:views="clr-namespace:Instrux.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/SidebarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Styles -->
            <Style x:Key="SubTabStyle" TargetType="RadioButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Border" Padding="16,10" CornerRadius="8,8,0,0"
                                    Background="Transparent" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.FontSize="13" TextElement.FontWeight="Medium"
                                                  TextElement.Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                    <Setter TargetName="Border" Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BgBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ViewModel → View DataTemplates -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <tabs:DashboardTab />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ClassManagerViewModel}">
                <tabs:ClassManagerTab />
            </DataTemplate>

            <!-- Phase 2 Sub-tab VMs -->
            <DataTemplate DataType="{x:Type vmTabs:TabRosterViewModel}">
                <tabs:TabRoster />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmTabs:TabAttendanceViewModel}">
                <tabs:TabAttendance />
            </DataTemplate>

            <!-- Phase 3 Sub-tab VMs -->
            <DataTemplate DataType="{x:Type vmTabs:TabMaterialsViewModel}">
                <tabs:TabMaterials />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TabGradesViewModel}">
                <tabs:TabGrades />
            </DataTemplate>

            <!-- Phase 4 Full-page VMs -->
            <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
                <tabs:CalendarEventTab />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TodoViewModel}">
                <tabs:TodoItemTab />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsProfileView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
