<UserControl x:Class="Instrux.App.Views.Tabs.TabMaterials"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Text="Materials" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"
                               Text="Share links, files, videos, and documents with your class" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="8"
                        Background="{StaticResource PrimaryBrush}">
                    <Button Command="{Binding MaterialsView.OpenAddDialogCommand}"
                            Background="Transparent"
                            Foreground="White" BorderThickness="0"
                            Padding="14,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 4v16m8-8H4" Stroke="White" StrokeThickness="2"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Add Material" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>

            <!-- Material Cards -->
            <ItemsControl ItemsSource="{Binding MaterialsView.ClassItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Margin="0,0,12,12"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" Opacity="0.06"
                                                              ShadowDepth="1" Color="#000000" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Type Badge -->
                                <Border Grid.Row="0" Padding="10,8"
                                        Background="{StaticResource PrimaryLightBrush}"
                                        CornerRadius="10,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                                              Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.5"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Text="{Binding Type}" />
                                    </StackPanel>
                                </Border>

                                <!-- Title -->
                                <StackPanel Grid.Row="1" Margin="16,12,16,8">
                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0">
                                        <Run Text="Added " />
                                        <Run Text="{Binding CreatedAt, StringFormat={}{0:MMM d}}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Actions -->
                                <Border Grid.Row="2" Padding="12,8"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Background="{StaticResource BgBrush}"
                                        CornerRadius="0,0,10,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="6"
                                                Background="{StaticResource PrimaryBrush}"
                                                Margin="0,0,8,0">
                                            <Button Command="{Binding DataContext.MaterialsView.OpenLinkCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    Foreground="White" BorderThickness="0"
                                                    Padding="12,4" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                                          Stroke="White" StrokeThickness="1.5"
                                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                    <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Button Grid.Column="1" Width="28" Height="28"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.MaterialsView.DeleteMaterialCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="M6 18L18 6M6 6l12 12"
                                                  Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"
                                                  Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Add Material Dialog -->
        <Border Visibility="Collapsed" Background="#80000000" Panel.ZIndex="100">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MaterialsView.IsAddDialogOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="420" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="32" Opacity="0.2" ShadowDepth="8" Color="#000000" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Text="Add Material" Margin="0,0,0,20" />

                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4">Title</TextBlock>
                    <Border CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,0,12">
                        <TextBox Text="{Binding MaterialsView.FormTitle}" Padding="10,8"
                                 BorderThickness="0" FontSize="13" />
                    </Border>

                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4">URL</TextBlock>
                    <Border CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,0,12">
                        <TextBox Text="{Binding MaterialsView.FormUrl}" Padding="10,8"
                                 BorderThickness="0" FontSize="13" />
                    </Border>

                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4">Type</TextBlock>
                    <Border CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,0,20">
                        <ComboBox ItemsSource="{Binding MaterialsView.TypeOptions}"
                                  Text="{Binding MaterialsView.FormType}"
                                  Padding="8,6" BorderThickness="0" FontSize="13" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Margin="0,0,12,0">
                            <Button Content="Cancel"
                                    Command="{Binding MaterialsView.CloseAddDialogCommand}"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Padding="16,10" />
                        </Border>
                        <Border Grid.Column="1" CornerRadius="8"
                                Background="{StaticResource PrimaryBrush}">
                            <Button Content="Add Material"
                                    Command="{Binding MaterialsView.AddMaterialCommand}"
                                    Background="Transparent"
                                    Foreground="White" BorderThickness="0" Padding="24,10" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
