<UserControl x:Class="Instrux.App.Views.Tabs.TabAttendance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Text="Attendance" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0">
                        <Run Text="Mark attendance for " />
                        <Run Text="{Binding AttendanceView.SelectedDate, StringFormat={}{0:ddd, MMM d}}" />
                    </TextBlock>
                </StackPanel>

                <!-- Date Picker -->
                <DatePicker Grid.Column="1"
                            SelectedDate="{Binding AttendanceView.SelectedDate}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />

                <!-- Quick Mark All -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                    <TextBlock Text="Mark all:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border CornerRadius="4" Background="{StaticResource SuccessLightBrush}"
                            Margin="0,0,4,0">
                        <Button Content="Present"
                                Command="{Binding AttendanceView.MarkAllCommand}"
                                CommandParameter="Present"
                                FontSize="11" Padding="10,4"
                                Background="Transparent"
                                Foreground="{StaticResource SuccessBrush}"
                                BorderThickness="0" Cursor="Hand" />
                    </Border>
                    <Border CornerRadius="4" Background="{StaticResource ErrorLightBrush}"
                            Margin="0,0,4,0">
                        <Button Content="Absent"
                                Command="{Binding AttendanceView.MarkAllCommand}"
                                CommandParameter="Absent"
                                FontSize="11" Padding="10,4"
                                Background="Transparent"
                                Foreground="{StaticResource ErrorBrush}"
                                BorderThickness="0" Cursor="Hand" />
                    </Border>
                    <Border CornerRadius="4" Background="{StaticResource WarningLightBrush}">
                        <Button Content="Late"
                                Command="{Binding AttendanceView.MarkAllCommand}"
                                CommandParameter="Late"
                                FontSize="11" Padding="10,4"
                                Background="Transparent"
                                Foreground="{StaticResource WarningBrush}"
                                BorderThickness="0" Cursor="Hand" />
                    </Border>
                </StackPanel>

                <!-- Save Button -->
                <Border Grid.Column="3" CornerRadius="8"
                        Background="{StaticResource PrimaryBrush}">
                    <Button Command="{Binding AttendanceView.SaveAttendanceCommand}"
                            Background="Transparent"
                            Foreground="White" BorderThickness="0"
                            Padding="14,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M5 13l4 4L19 7" Stroke="White" StrokeThickness="2"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Save" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>

            <!-- Attendance Table -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="0">
                <ItemsControl ItemsSource="{Binding AttendanceView.Students}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,12"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Student Info -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="S" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding StudentName}" />
                                    </StackPanel>

                                    <!-- Status ComboBox -->
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding Status}"
                                              ItemsSource="{Binding DataContext.AttendanceView.StatusOptions,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Width="120" FontSize="12"
                                              VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
