<UserControl x:Class="Instrux.App.Views.Tabs.ClassManagerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dto="clr-namespace:Instrux.Services.DTOs;assembly=Instrux.Services"
             xmlns:vm="clr-namespace:Instrux.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <!-- Class List View (default) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShowingDetail}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel Margin="0,0,0,24">
                    <!-- Header -->
                    <StackPanel Margin="0,24,0,24">
                        <TextBlock FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="My Classes" />
                        <TextBlock FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,0"
                                   Text="Manage your classes, students, and attendance" />
                    </StackPanel>

                    <!-- Action Bar -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding Classes.Count, FallbackValue=0}" />
                                <Run Text="classes total" />
                            </TextBlock>
                            <Border CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                                <Button Grid.Column="2" Command="{Binding OpenCreateDialogCommand}"
                                        Background="Transparent"
                                        Foreground="White" BorderThickness="0"
                                        Padding="16,8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12 4v16m8-8H4" Stroke="White" StrokeThickness="2"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="New Class" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Class Cards Grid -->
                    <ItemsControl ItemsSource="{Binding Classes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="280" Margin="0,0,16,16"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="12" Opacity="0.08"
                                                                      ShadowDepth="2" Color="#000000" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="20" Opacity="0.15"
                                                                              ShadowDepth="4" Color="#000000" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Colored Header -->
                                        <Border Grid.Row="0" Height="80"
                                                Background="{Binding ColorHex}"
                                                CornerRadius="12,12,0,0">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="16">
                                                    <TextBlock FontSize="18" FontWeight="Bold"
                                                               Foreground="White"
                                                               Text="{Binding Name}" />
                                                    <TextBlock FontSize="12" Foreground="#FFFFFFCC"
                                                               Margin="0,2,0,0">
                                                        <Run Text="{Binding Subject}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding Section}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Delete Button -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,8,8,0"
                                                        Background="#33FFFFFF"
                                                        Width="28" Height="28" CornerRadius="14">
                                                    <Button Background="Transparent" Foreground="White"
                                                            BorderThickness="0" Width="28" Height="28"
                                                            Cursor="Hand" Padding="0"
                                                            Command="{Binding DataContext.DeleteClassCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="M6 18L18 6M6 6l12 12"
                                                              Stroke="White" StrokeThickness="1.5"
                                                              Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Row="1" Margin="16,12,16,8">
                                            <TextBlock FontSize="13" Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="{Binding Term}" />
                                                <Run Text="Term" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Spacer -->
                                        <Grid Grid.Row="2" />

                                        <!-- Footer -->
                                        <Border Grid.Row="3" Padding="16,12"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Background="{StaticResource BgBrush}"
                                                CornerRadius="0,0,12,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Path Data="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                                                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"
                                                          Width="16" Height="16" Stretch="Uniform"
                                                          Margin="0,0,6,0" />
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding StudentCount, FallbackValue=0}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="6"
                                                        Background="{StaticResource PrimaryBrush}">
                                                    <Button Background="Transparent"
                                                            Foreground="White" BorderThickness="0"
                                                            Padding="12,4" Cursor="Hand"
                                                            Command="{Binding DataContext.NavigateToClassDetailFromCardCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold" />
                                                    </Button>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Detail View -->
        <Grid Visibility="Collapsed">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShowingDetail}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Class Detail Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="0,24,0,0">
                <StackPanel>
                    <!-- Back Button -->
                    <Button Command="{Binding BackToClassesCommand}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M15 19l-7-7 7-7"
                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Back to Classes" FontSize="13"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Class Info -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="{Binding SelectedClass.Name}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding SelectedClass.Subject}" />
                            </TextBlock>
                            <TextBlock FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="6,0">·</TextBlock>
                            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Section " />
                                <Run Text="{Binding SelectedClass.Section}" />
                            </TextBlock>
                            <TextBlock FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="6,0">·</TextBlock>
                            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding SelectedClass.Term}" />
                                <Run Text="Term" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sub-tabs -->
                    <Border Padding="0" Background="{StaticResource BgBrush}"
                            CornerRadius="12,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <RadioButton GroupName="ClassSubTabs"
                                         IsChecked="{Binding ClassDetailView.IsRosterSelected}"
                                         Command="{Binding ClassDetailView.SwitchToSubTabCommand}"
                                         CommandParameter="{x:Static vm:ClassSubTab.Roster}"
                                         Style="{StaticResource SubTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Roster" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="ClassSubTabs"
                                         IsChecked="{Binding ClassDetailView.IsAttendanceSelected}"
                                         Command="{Binding ClassDetailView.SwitchToSubTabCommand}"
                                         CommandParameter="{x:Static vm:ClassSubTab.Attendance}"
                                         Style="{StaticResource SubTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Attendance" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="ClassSubTabs"
                                         IsChecked="{Binding ClassDetailView.IsMaterialsSelected}"
                                         Command="{Binding ClassDetailView.SwitchToSubTabCommand}"
                                         CommandParameter="{x:Static vm:ClassSubTab.Materials}"
                                         Style="{StaticResource SubTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Materials" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="ClassSubTabs"
                                         IsChecked="{Binding ClassDetailView.IsGradesSelected}"
                                         Command="{Binding ClassDetailView.SwitchToSubTabCommand}"
                                         CommandParameter="{x:Static vm:ClassSubTab.Grades}"
                                         Style="{StaticResource SubTabStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Grades" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sub-tab Content -->
            <ContentControl Grid.Row="1" Margin="0,20,0,0"
                            Content="{Binding ClassSubView}" />
        </Grid>

        <!-- Create Class Dialog Overlay -->
        <Border Background="#80000000" Panel.ZIndex="100">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreateDialogOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="440" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="32" Opacity="0.2" ShadowDepth="8" Color="#000000" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Text="Create New Class" Margin="0,0,0,20" />

                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4">Class Name</TextBlock>
                    <Border CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,0,12">
                        <TextBox Text="{Binding FormName}" Padding="10,8"
                                 BorderThickness="0" FontSize="13" />
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4">Subject</TextBlock>
                            <Border CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <TextBox Text="{Binding FormSubject}" Padding="10,8"
                                         BorderThickness="0" FontSize="13" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4">Section</TextBlock>
                            <Border CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <TextBox Text="{Binding FormSection}" Padding="10,8"
                                         BorderThickness="0" FontSize="13" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4">Term</TextBlock>
                    <Border CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,0,16">
                        <TextBox Text="{Binding FormTerm}" Padding="10,8"
                                 BorderThickness="0" FontSize="13" />
                    </Border>

                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8">Class Color</TextBlock>
                    <ItemsControl ItemsSource="{x:Static vm:ClassManagerViewModel.ColorOptions}"
                                  Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="{Binding}"
                                        BorderThickness="2"
                                        Margin="0,0,8,0" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=FormColorHex, Path=Text}"
                                                             Value="{Binding}">
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Margin="0,0,12,0">
                            <Button Content="Cancel"
                                    Command="{Binding CloseCreateDialogCommand}"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Padding="16,10" />
                        </Border>
                        <Border Grid.Column="1" CornerRadius="8"
                                Background="{StaticResource PrimaryBrush}">
                            <Button Content="Create Class"
                                    Command="{Binding CreateClassCommand}"
                                    Background="Transparent"
                                    Foreground="White" BorderThickness="0" Padding="24,10" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
