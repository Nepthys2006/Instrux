<UserControl x:Class="Instrux.App.Views.Tabs.TodoItemTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="*" />
                <DataGridCheckBoxColumn Header="Done" Binding="{Binding IsCompleted}" Width="60" />
                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat={}{0:d}}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Padding="8" Margin="0,8,0,0"
                BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Title:" Width="80" VerticalAlignment="Center" />
                    <TextBox Text="{Binding FormTitle}" Width="240" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Priority:" Width="80" VerticalAlignment="Center" />
                    <ComboBox Text="{Binding FormPriority}" Width="240" IsEditable="True">
                        <ComboBoxItem Content="Low" />
                        <ComboBoxItem Content="Medium" />
                        <ComboBoxItem Content="High" />
                    </ComboBox>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Due Date:" Width="80" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding FormDueDate}" Width="240" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="Add New" Command="{Binding AddNewCommand}" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="12,4" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
