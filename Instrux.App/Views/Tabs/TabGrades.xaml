<UserControl x:Class="Instrux.App.Views.Tabs.TabGrades"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Text="Grades" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"
                               Text="Manage assessments and grades" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="8"
                        Background="{StaticResource PrimaryBrush}">
                    <Button Command="{Binding GradesView.OpenAddAssessmentDialogCommand}"
                            Background="Transparent"
                            Foreground="White" BorderThickness="0"
                            Padding="14,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 4v16m8-8H4" Stroke="White" StrokeThickness="2"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="New Assessment" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>

            <!-- Assessments List -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="0">
                <ItemsControl ItemsSource="{Binding GradesView.Assessments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,12"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="{Binding Name}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="Max: " />
                                            <Run Text="{Binding MaxScore}" />
                                            <Run Text="pts · " />
                                            <Run Text="{Binding DateCreated, StringFormat={}{0:MMM d}}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="1" CornerRadius="6"
                                            Background="{StaticResource PrimaryBrush}"
                                            Margin="0,0,8,0">
                                        <Button Command="{Binding DataContext.GradesView.OpenGradeEditorCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                Foreground="White" BorderThickness="0"
                                                Padding="12,4" Cursor="Hand">
                                            <TextBlock Text="Grade" FontSize="11" FontWeight="SemiBold" />
                                        </Button>
                                    </Border>

                                    <Button Grid.Column="2" Width="28" Height="28"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" VerticalAlignment="Center"
                                            Command="{Binding DataContext.GradesView.DeleteAssessmentCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="M6 18L18 6M6 6l12 12"
                                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"
                                              Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- Add Assessment Dialog -->
        <Border Visibility="Collapsed" Background="#80000000" Panel.ZIndex="100">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GradesView.IsAddAssessmentDialogOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="420" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="32" Opacity="0.2" ShadowDepth="8" Color="#000000" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Text="New Assessment" Margin="0,0,0,20" />

                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4">Assessment Name</TextBlock>
                    <Border CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,0,12">
                        <TextBox Text="{Binding GradesView.FormAssessmentName}" Padding="10,8"
                                 BorderThickness="0" FontSize="13" />
                    </Border>

                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4">Max Score</TextBlock>
                    <Border CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Margin="0,0,0,20">
                        <TextBox Text="{Binding GradesView.FormMaxScore}" Padding="10,8"
                                 BorderThickness="0" FontSize="13" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Margin="0,0,12,0">
                            <Button Content="Cancel"
                                    Command="{Binding GradesView.CloseAddAssessmentDialogCommand}"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Padding="16,10" />
                        </Border>
                        <Border Grid.Column="1" CornerRadius="8"
                                Background="{StaticResource PrimaryBrush}">
                            <Button Content="Create Assessment"
                                    Command="{Binding GradesView.AddAssessmentCommand}"
                                    Background="Transparent"
                                    Foreground="White" BorderThickness="0" Padding="24,10" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
