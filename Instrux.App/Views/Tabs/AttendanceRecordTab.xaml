<UserControl x:Class="Instrux.App.Views.Tabs.AttendanceRecordTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:d}}" Width="*" />
                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="2*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Padding="8" Margin="0,8,0,0"
                BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Class:" Width="80" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Classes}" SelectedValuePath="Id"
                              SelectedValue="{Binding FormClassId}" Width="240">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Language="en-US" Text="{Binding Name}" />
                                    <Run Language="en-US" Text=" (" />
                                    <Run Language="en-US" Text="{Binding Section}" />
                                    <Run Language="en-US" Text=")" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Student:" Width="80" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Students}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding FormStudentId}"
                              Width="240" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Date:" Width="80" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding FormDate}" Width="240" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Status:" Width="80" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FormStatus}" Width="240" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Note:" Width="80" VerticalAlignment="Center" />
                    <TextBox Text="{Binding FormNote}" Width="240" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="Add New" Command="{Binding AddNewCommand}" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="12,4" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
